# Copy to .env and fill in. Never commit .env.

# ── Required ──────────────────────────────────────────────────────────────────
CTM_ENDPOINT=https://<tenant>-aapi.<region>.controlm.com/automation-api
CTM_API_TOKEN=<your-api-token>
CTM_ENV_NAME=default

# ── Agent (leave CTM_AGENT_TAG empty for CLI-only) ────────────────────────────
# CTM_AGENT_MODE: saas | agent | none (default: saas when CTM_AGENT_TAG is set)
CTM_AGENT_MODE=
CTM_AGENT_IMAGE=Agent_Alma.Linux
CTM_AGENT_TAG=
CTM_AGENT_NAME=
# agent mode only (positional: set CTM_SERVER and CTM_AGENT_NAME before CTM_AGENT_PORT)
CTM_SERVER=
CTM_AGENT_PORT=
# Optional -f <file> / -r <repository>
CTM_AGENT_CONFIG_FILE=
CTM_AGENT_REPO=

# ── Plugins (deployed after the agent installs) ───────────────────────────────
CTM_DEPLOY_PLUGINS=false
# Comma-separated list, e.g. AWS_Lambda_plugin.Linux,Azure_Service_Bus_plugin.Linux,OCI_Functions_plugin.Linux
CTM_PLUGINS=DataAssurance_plugin.Linux
